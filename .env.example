# 데이터베이스 (필수) — Vercel Postgres/Neon 연결 문자열.
# Vercel 프로젝트 설정 > Storage 탭에서 Postgres(Neon) 데이터베이스를 생성하면
# 이 값(또는 POSTGRES_URL)이 자동으로 채워집니다. 로컬 개발 시에는 직접 발급받은
# Neon 연결 문자열을 넣어주세요 (예: postgres://user:pass@host.neon.tech/db).
DATABASE_URL=

# 관리자 모드 (필수: 배포 전 반드시 강력한 값으로 설정)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 이메일 발송(SMTP) — 미설정 시 문의는 DB에만 저장되고 메일은 발송되지 않습니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 문의 수신 주소 (미설정 시 아래 기본값 사용)
MAIL_TO_GENERAL=info@evlaser.co.kr
MAIL_TO_CEO=sbhan3763@naver.com
